{
  "name": "is3-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del Sistema Institucional de Expediente Electrónico (IS3)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "demo:cargar": "node ../scripts/demo/cargar-demo.mjs",
    "db:studio": "prisma studio",
    "respaldo:crear": "tsx src/cli/respaldo.ts crear",
    "respaldo:verificar": "tsx src/cli/respaldo.ts verificar",
    "respaldo:restaurar": "tsx src/cli/respaldo.ts restaurar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
