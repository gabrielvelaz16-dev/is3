// Modelo de datos — Sprint 2 (S2-01) + Sprint 3 (S3-01): expedientes. Sprints 4 a 6: ver secciones.
// Documentación: docs/03-modelo-datos/modelo-datos.md
// La URL de conexión se configura en prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Dependencia {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(20)
  nombre   String    @db.VarChar(120)
  activa   Boolean   @default(true)
  usuarios    Usuario[]
  expedientes Expediente[]
  pasesOrigen  Pase[] @relation("paseOrigen")
  pasesDestino Pase[] @relation("paseDestino")

  @@map("dependencias")
}

model Rol {
  id          Int          @id @default(autoincrement())
  clave       String       @unique @db.VarChar(40)
  nombre      String       @db.VarChar(80)
  descripcion String       @db.VarChar(255)
  permisos    RolPermiso[]
  usuarios    Usuario[]

  @@map("roles")
}

model Permiso {
  id          Int          @id @default(autoincrement())
  clave       String       @unique @db.VarChar(60)
  descripcion String       @db.VarChar(255)
  roles       RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int     @map("rol_id")
  permisoId Int     @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Usuario {
  id            Int         @id @default(autoincrement())
  username      String      @unique @db.VarChar(30)
  email         String      @unique @db.VarChar(160)
  nombre        String      @db.VarChar(120)
  passwordHash  String      @map("password_hash") @db.VarChar(255)
  rolId         Int         @map("rol_id")
  dependenciaId Int         @map("dependencia_id")
  activo        Boolean     @default(true)
  ultimoAcceso  DateTime?   @map("ultimo_acceso")
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")
  rol           Rol         @relation(fields: [rolId], references: [id], onDelete: Restrict)
  dependencia   Dependencia @relation(fields: [dependenciaId], references: [id], onDelete: Restrict)
  sesiones      Sesion[]
  auditoria     Auditoria[]

  expedientesCreados     Expediente[] @relation("creadoPor")
  expedientesResponsable Expediente[] @relation("responsable")
  expedientesDesactivados Expediente[] @relation("desactivadoPor")
  documentosSubidos      Documento[]
  actuaciones            Actuacion[]
  cambiosEstado          CambioEstado[]
  tareasAsignadas        Tarea[]        @relation("tareaAsignada")
  tareasCreadas          Tarea[]        @relation("tareaCreada")
  pasesEnviados          Pase[]         @relation("paseEnviado")
  pasesRecibidos         Pase[]         @relation("paseRecibido")
  asignacionesHechas     Asignacion[]   @relation("asignacionHecha")
  asignacionesRecibidas  Asignacion[]   @relation("asignacionRecibida")
  notificaciones         Notificacion[]

  @@index([rolId])
  @@index([dependenciaId])
  @@map("usuarios")
}

/// Sesión del lado del servidor (ADR-05). El id es el hash SHA-256 del token;
/// el token en claro solo existe en la cookie del navegador.
model Sesion {
  id        String   @id @db.Char(64)
  usuarioId Int      @map("usuario_id")
  creadaEn  DateTime @default(now()) @map("creada_en")
  expiraEn  DateTime @map("expira_en")
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

/// Registro de auditoría de solo inserción (ADR-07, RF-20).
model Auditoria {
  id        Int       @id @default(autoincrement())
  fecha     DateTime  @default(now())
  usuarioId Int?      @map("usuario_id")
  accion    String    @db.VarChar(60)
  resultado String    @db.VarChar(10)
  entidad   String?   @db.VarChar(60)
  entidadId String?   @map("entidad_id") @db.VarChar(60)
  detalle   Json?
  ip        String?   @db.VarChar(64)
  requestId String?   @map("request_id") @db.VarChar(64)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([fecha])
  @@index([usuarioId])
  @@index([accion])
  @@map("auditoria")
}

// ── Sprint 3: Expedientes ──────────────────────────────────────────

enum EstadoExpediente {
  BORRADOR
  EN_TRAMITE
  EN_REVISION
  RESUELTO
  ARCHIVADO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

model Expediente {
  id                 Int              @id @default(autoincrement())
  numero             String           @unique @db.VarChar(20)
  caratula           String           @db.VarChar(255)
  asunto             String           @db.Text
  tipo               String           @db.VarChar(60)
  iniciador          String           @db.VarChar(160)
  estado             EstadoExpediente @default(BORRADOR)
  prioridad          Prioridad        @default(MEDIA)
  dependenciaActualId Int             @map("dependencia_actual_id")
  creadoPorId        Int              @map("creado_por_id")
  responsableId      Int?             @map("responsable_id")
  fechaVencimiento   DateTime?        @map("fecha_vencimiento")
  descripcion        String?          @db.Text
  creadoEn           DateTime         @default(now()) @map("creado_en")
  actualizadoEn      DateTime         @updatedAt @map("actualizado_en")
  /// CR-08: un expediente desactivado sale de listas, indicadores y pendientes, y queda en solo lectura.
  activo              Boolean          @default(true)
  desactivadoEn       DateTime?        @map("desactivado_en")
  desactivadoPorId    Int?             @map("desactivado_por_id")
  motivoDesactivacion String?          @map("motivo_desactivacion") @db.VarChar(500)

  dependenciaActual Dependencia @relation(fields: [dependenciaActualId], references: [id], onDelete: Restrict)
  desactivadoPor    Usuario?    @relation("desactivadoPor", fields: [desactivadoPorId], references: [id], onDelete: Restrict)
  creadoPor         Usuario     @relation("creadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  responsable       Usuario?    @relation("responsable", fields: [responsableId], references: [id], onDelete: Restrict)
  documentos        Documento[]
  actuaciones       Actuacion[]
  cambiosEstado     CambioEstado[]
  tareas            Tarea[]
  pases             Pase[]
  asignaciones      Asignacion[]
  notificaciones    Notificacion[]

  @@index([estado])
  @@index([dependenciaActualId])
  @@index([fechaVencimiento])
  @@index([creadoPorId])
  @@index([activo])
  @@map("expedientes")
}

/// Genera números de expediente de forma atómica por año (EXP-AAAA-NNNNNN).
model Secuencia {
  anio          Int @id @map("anio")
  ultimoNumero  Int @default(0) @map("ultimo_numero")

  @@map("secuencias")
}

// ── Sprint 4: Documentos y actuaciones ─────────────────────────────

enum TipoActuacion {
  ACTUACION
  OBSERVACION
}

/// Documento adjunto a un expediente (RF-08, RNF-04, ADR-08, ADR-12).
/// El archivo vive en STORAGE_PATH con un nombre aleatorio; aquí solo los metadatos y el hash.
/// Solo inserción: un documento incorporado no se modifica ni se borra (historial completo).
model Documento {
  id               Int      @id @default(autoincrement())
  expedienteId     Int      @map("expediente_id")
  nombreOriginal   String   @map("nombre_original") @db.VarChar(255)
  nombreAlmacenado String   @unique @map("nombre_almacenado") @db.VarChar(80)
  tipoMime         String   @map("tipo_mime") @db.VarChar(120)
  tamanoBytes      Int      @map("tamano_bytes")
  hashSha256       String   @map("hash_sha256") @db.Char(64)
  descripcion      String?  @db.VarChar(500)
  subidoPorId      Int      @map("subido_por_id")
  subidoEn         DateTime @default(now()) @map("subido_en")

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  subidoPor  Usuario    @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@map("documentos")
}

/// Actuación u observación registrada en un expediente (RF-10). Solo inserción.
model Actuacion {
  id           Int           @id @default(autoincrement())
  expedienteId Int           @map("expediente_id")
  tipo         TipoActuacion
  texto        String        @db.Text
  autorId      Int           @map("autor_id")
  fecha        DateTime      @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  autor      Usuario    @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@map("actuaciones")
}

/// Cada cambio de estado del expediente, para el historial (RF-11). Solo inserción.
model CambioEstado {
  id             Int               @id @default(autoincrement())
  expedienteId   Int               @map("expediente_id")
  estadoAnterior EstadoExpediente? @map("estado_anterior")
  estadoNuevo    EstadoExpediente  @map("estado_nuevo")
  motivo         String?           @db.VarChar(500)
  usuarioId      Int               @map("usuario_id")
  fecha          DateTime          @default(now())

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@map("cambios_estado")
}

// ── Sprint 5: Tareas y seguimiento ─────────────────────────────────

enum EstadoTarea {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

/// Tarea sobre un expediente con responsable y vencimiento (RF-13).
model Tarea {
  id           Int         @id @default(autoincrement())
  expedienteId Int         @map("expediente_id")
  titulo       String      @db.VarChar(160)
  descripcion  String?     @db.Text
  asignadoAId  Int         @map("asignado_a_id")
  creadoPorId  Int         @map("creado_por_id")
  vencimiento  DateTime
  estado       EstadoTarea @default(PENDIENTE)
  creadaEn     DateTime    @default(now()) @map("creada_en")
  actualizadaEn DateTime   @updatedAt @map("actualizada_en")
  cerradaEn    DateTime?   @map("cerrada_en")

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  asignadoA  Usuario    @relation("tareaAsignada", fields: [asignadoAId], references: [id], onDelete: Restrict)
  creadoPor  Usuario    @relation("tareaCreada", fields: [creadoPorId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@index([asignadoAId, estado])
  @@index([vencimiento])
  @@map("tareas")
}

/// Pase de un expediente entre dependencias (RF-15, RF-16).
/// Mientras no se recibe, el expediente está "en tránsito"; solo puede haber uno pendiente.
model Pase {
  id            Int       @id @default(autoincrement())
  expedienteId  Int       @map("expediente_id")
  origenId      Int       @map("origen_id")
  destinoId     Int       @map("destino_id")
  motivo        String    @db.VarChar(500)
  enviadoPorId  Int       @map("enviado_por_id")
  enviadoEn     DateTime  @default(now()) @map("enviado_en")
  recibidoPorId Int?      @map("recibido_por_id")
  recibidoEn    DateTime? @map("recibido_en")

  expediente  Expediente  @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  origen      Dependencia @relation("paseOrigen", fields: [origenId], references: [id], onDelete: Restrict)
  destino     Dependencia @relation("paseDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  enviadoPor  Usuario     @relation("paseEnviado", fields: [enviadoPorId], references: [id], onDelete: Restrict)
  recibidoPor Usuario?    @relation("paseRecibido", fields: [recibidoPorId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@index([destinoId, recibidoEn])
  @@map("pases")
}

/// Cada asignación de responsable, para el historial (RF-12). Solo inserción.
model Asignacion {
  id            Int      @id @default(autoincrement())
  expedienteId  Int      @map("expediente_id")
  responsableId Int?     @map("responsable_id")
  usuarioId     Int      @map("usuario_id")
  fecha         DateTime @default(now())

  expediente  Expediente @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  responsable Usuario?   @relation("asignacionRecibida", fields: [responsableId], references: [id], onDelete: Restrict)
  usuario     Usuario    @relation("asignacionHecha", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([expedienteId])
  @@map("asignaciones")
}

// ── Sprint 6: Notificaciones internas ──────────────────────────────

enum TipoNotificacion {
  EXPEDIENTE_ASIGNADO
  TAREA_ASIGNADA
  PASE_ENTRANTE
}

/// Aviso para un usuario (S5-06, RF-17). Solo lo ve su destinatario; leerlo registra la fecha.
model Notificacion {
  id           Int              @id @default(autoincrement())
  usuarioId    Int              @map("usuario_id")
  tipo         TipoNotificacion
  mensaje      String           @db.VarChar(300)
  expedienteId Int?             @map("expediente_id")
  creadaEn     DateTime         @default(now()) @map("creada_en")
  leidaEn      DateTime?        @map("leida_en")

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expediente Expediente? @relation(fields: [expedienteId], references: [id], onDelete: Restrict)

  @@index([usuarioId, leidaEn])
  @@index([expedienteId])
  @@map("notificaciones")
}
