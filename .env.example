# =============================================================================
# IS3 — Sistema de Expediente Electrónico · Variables de entorno de ejemplo
# -----------------------------------------------------------------------------
# 1. Copiar este archivo como .env   (PowerShell: Copy-Item .env.example .env)
# 2. Reemplazar los valores "cambiar_..." por valores locales propios.
# 3. NUNCA subir .env a Git (ya está excluido en .gitignore).
# Todos los datos del sistema son ficticios y de uso académico.
# =============================================================================

# --- PostgreSQL (contenedor de Docker Compose) -------------------------------
POSTGRES_USER=is3_app
POSTGRES_PASSWORD=cambiar_esta_clave_local
POSTGRES_DB=expediente
# Puerto de la PC donde se publica PostgreSQL (cambiar si 5432 está ocupado)
POSTGRES_PORT=5432

# --- Conexión de Prisma (backend, desde el Sprint 2) -------------------------
# Debe coincidir con las variables de arriba.
DATABASE_URL=postgresql://is3_app:cambiar_esta_clave_local@localhost:5432/expediente?schema=public
# Base separada para las pruebas automatizadas (se crea sola al iniciar el contenedor)
DATABASE_URL_TEST=postgresql://is3_app:cambiar_esta_clave_local@localhost:5432/expediente_test?schema=public

# --- Backend (Sprint 1) ------------------------------------------------------
NODE_ENV=development
PORT=3000
# Duración de la sesión en horas (1 a 24). COOKIE_SECURE=true solo con HTTPS.
SESSION_HOURS=8
COOKIE_SECURE=false

# --- Usuario administrador inicial (seed, Sprint 2) --------------------------
# Se crea con "npm run db:seed" si no existe. La contraseña debe tener al menos
# 10 caracteres con letras y números. Cambiarla aquí NO cambia la de un
# administrador ya creado (eso se hace desde la pantalla de usuarios).
ADMIN_EMAIL=admin@institucion.test
ADMIN_NOMBRE=Administrador del sistema
ADMIN_PASSWORD=cambiar_esta_clave_admin1

# --- Documentos adjuntos (Sprint 4) -----------------------------------------
STORAGE_PATH=./storage/documentos
MAX_UPLOAD_MB=10

# --- Frontend -----------------------------------------------------------------
# No necesita variables: en desarrollo Vite reenvía /api al backend (proxy),
# así frontend y API comparten origen y la cookie de sesión funciona sin CORS.
